rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null && exists(/databases/$(db)/documents/accounts/$(request.auth.uid)); }
    function acct() { return get(/databases/$(db)/documents/accounts/$(request.auth.uid)).data; }
    function mod() { return signed() && acct().role == 'mod'; }

    // Contas: só moderador cria/edita; cada um lê a sua.
    match /accounts/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || mod());
      allow write: if mod();
    }
    // Páginas: public (todos), players (logados), restrict (só os uids em "allow").
    match /pages/{id} {
      allow read: if resource.data.vis == 'public'
        || (signed() && (resource.data.vis == 'players' || mod()
            || (resource.data.allow != null && request.auth.uid in resource.data.allow)));
      allow write: if mod();
    }
    // Perfil e anotações: o dono escreve só "notes" e "display"; moderador lê tudo.
    match /players/{u} {
      allow read: if signed() && (acct().username == u || mod());
      allow create, update: if signed() && (mod()
        || (acct().username == u && request.resource.data.keys().hasOnly(['notes', 'display'])));
      allow delete: if mod();
    }
  }
}
